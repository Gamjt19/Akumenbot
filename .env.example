# Discord bot token from the Discord Developer Portal (Bot tab).
DISCORD_TOKEN=your_token_here

# PostgreSQL / Supabase connection string (or DATABASE_URL)
DB_URL=postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://user:password@host:port/dbname

# IANA timezone name used for determining "calendar day" boundaries and the daily report time.
TIMEZONE=Asia/Kolkata

# Your Discord server (guild) ID. Used to sync slash commands instantly to one server.
GUILD_ID=your_guild_id

# The channel where students post their "Day N: ..." updates.
SUBMISSION_CHANNEL_ID=your_channel_id

# The trainer / admin channel where daily challenge reports get posted.
TRAINER_CHANNEL_ID=your_trainer_channel_id

# The channel where student assignments are posted via /assignment command.
ASSIGNMENTS_CHANNEL_ID=your_assignments_channel_id

# The channel where milestone achievement badges are announced.
ACHIEVEMENTS_CHANNEL_ID=your_achievements_channel_id

# Name of the Discord role that should be treated as "trainer" for admin commands.
TRAINER_ROLE_NAME=trainer

# 24-hour local time (in TIMEZONE) at which the daily report is posted (default: 00:05).
DAILY_REPORT_HOUR=0
DAILY_REPORT_MINUTE=5
