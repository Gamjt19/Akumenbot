# Discord bot token from the Discord Developer Portal (Bot tab).
DISCORD_TOKEN=your_token_here

# SQLite database URL. In Docker this points inside the mounted volume (see Dockerfile/README).
DATABASE_URL=sqlite:///data/challenge.db

# IANA timezone name used for determining "calendar day" boundaries and the daily report time.
TIMEZONE=Asia/Kolkata

# Your Discord server (guild) ID. Used to sync slash commands instantly to one server
# instead of waiting up to ~1 hour for global command propagation.
GUILD_ID=your_guild_id

# The channel where students post their "Day N: ..." updates.
SUBMISSION_CHANNEL_ID=your_channel_id

# The channel where the automatic daily report gets posted.
ADMIN_CHANNEL_ID=your_admin_channel_id

# Name of the Discord role that should be treated as "trainer" for admin commands
# (/status, /missed, /reset, /export). Server Administrators always have access too.
TRAINER_ROLE_NAME=Trainer

# 24-hour local time (in TIMEZONE) at which the daily report is posted.
DAILY_REPORT_HOUR=21
DAILY_REPORT_MINUTE=0
